{
  "name": "family-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "smoke": "node scripts/smoke-test.mjs",
    "audit": "npm audit --audit-level=moderate",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run audit && npm run build",
    "env:check": "node scripts/check-env.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:check": "node scripts/check-db.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:smoke:money": "tsx scripts/check-money-db.ts",
    "db:backup": "node scripts/backup-database.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "dexie": "^4.0.11",
    "next": "^15.5.18",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.15.24",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.18",
    "prisma": "^6.8.2",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}
