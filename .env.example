# Local development can use the same PostgreSQL URL for both values.
# Supabase production should use a pooled runtime URL for DATABASE_URL and a
# direct/session-pooler migration URL for DIRECT_URL.
DATABASE_URL="postgresql://family_os:family_os@localhost:5432/family_os"
DIRECT_URL="postgresql://family_os:family_os@localhost:5432/family_os"

# Supabase example:
# DATABASE_URL="postgresql://prisma.<PROJECT_REF>:<PASSWORD>@<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://prisma.<PROJECT_REF>:<PASSWORD>@<REGION>.pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_VAPID_SUBJECT="mailto:admin@example.com"
FAMILY_OS_BASE_URL="http://localhost:3000"
FAMILY_OS_BILLING_PROVIDER="mock"
FAMILY_OS_BILLING_WEBHOOK_SECRET=""
